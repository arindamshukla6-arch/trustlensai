# Copy this file to .env and edit. Never commit your real .env.
REVIEWER_ACCESS_CODE=change-me
RETENTION_DAYS=30
MAX_UPLOAD_MB=50
# TRUSTLENS_DATA_DIR=data
# TRUSTLENS_MODELS_DIR=models
# Windows only, if tesseract.exe is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Risk aggregation - UNVALIDATED prototype defaults. Calibrate before any real use.
WEIGHT_FACE_MATCH=0.30
WEIGHT_VIDEO_REPLAY=0.25
WEIGHT_CHALLENGE=0.15
WEIGHT_DOC_INTEGRITY=0.25
WEIGHT_DOC_METADATA=0.15
WEIGHT_IMAGE_FORENSICS=0.35
WEIGHT_AI_TEXT=0.05
WEAK_SIGNAL_CAP=0.10
THRESHOLD_MODERATE=0.20
THRESHOLD_ELEVATED=0.45

# Face matching (OpenCV SFace published cosine threshold)
FACE_MATCH_THRESHOLD=0.363
FACE_MATCH_MARGIN=0.05
